{
  "name": "swarm-orbit",
  "private": true,
  "version": "0.0.42",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lines": "tsx scripts/lines.ts",
    "bot": "tsx scripts/bot.ts",
    "onboard": "tsx scripts/onboard.ts",
    "package": "tsx scripts/package.ts",
    "package:cg": "tsx scripts/package.ts --cg",
    "size": "tsx scripts/size.ts",
    "telemetry:pull": "tsx scripts/telemetry-pull.ts",
    "telemetry:trace": "tsx scripts/telemetry-trace.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
