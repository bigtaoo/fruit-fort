{
  // Our own telemetry collector (server/index.ts): takes a batch from the game, puts it in R2.
  // Same gamestao.com account as wrangler/web.jsonc.
  //
  // Deploy (from the repo root):  npx wrangler deploy -c wrangler/collect.jsonc
  // First time, in this order:
  //   npx wrangler r2 bucket create swarm-orbit-telemetry
  //   npx wrangler deploy -c wrangler/collect.jsonc
  //   npx wrangler secret put EXPORT_TOKEN -c wrangler/collect.jsonc     (any long random string)
  // Then build the game with VITE_TELEMETRY=https://sx.gamestao.com/c — without it the game sends nothing.
  //
  // The hostname is deliberately meaningless. The web build gets a readable name because a player reads
  // and shares it; this one is only ever in a POST, and `telemetry.`/`analytics.`/`metrics.` are the
  // names generic blocklists match on. A blocked collector loses exactly the players we most want to
  // see — the ones on a locked-down browser that also struggles to run the game.
  "name": "swarm-orbit-collect",
  "main": "../server/index.ts",
  "compatibility_date": "2026-11-21",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "sx.gamestao.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "swarm-orbit-telemetry" }
  ],
  // A loose filter against one page in a loop, not abuse prevention: the count is per edge location.
  // A 10-minute session sends about 10 batches, so 120 a minute leaves room for a whole family.
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ]
  // EXPORT_TOKEN is a secret, not a var: never write it here.
  // ORIGINS (optional) can be set to e.g. "crazygames.com,playgama.ai,gamestao.com" once we know every
  // host the game is framed on. Left unset it accepts any origin, which is the safe default: a wrong
  // list drops real data silently.
}
